{
  "name": "campusride",
  "private": true,
  "version": "0.0.1",
  "description": "CampusRide – college community ride-sharing platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm --filter @campusride/shared build && pnpm --filter @campusride/api-client build && pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter @campusride/shared test && pnpm --filter api test",
    "test:int": "pnpm --filter api test:int",
    "test:e2e": "pnpm --filter api test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:reset": "pnpm --filter api db:reset",
    "db:psql": "docker compose -f infra/docker-compose.yml exec postgres psql -U campusride -d campusride",
    "openapi:gen": "pnpm --filter api openapi:gen",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
