# ==============================================================================
# CampusRide Environment Variables
# Copy this file to .env for local development: cp .env.example .env
# Never commit .env or secrets to version control.
# ==============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=CampusRide
PORT=3001
API_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Local docker-compose PostgreSQL + PostGIS
DATABASE_URL=postgresql://campusride:campusride_dev_password@localhost:5432/campusride
DATABASE_POOL_MAX=10

# ── Authentication & Security ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_security_1234
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=2592000
# Generate with: openssl rand -base64 48
OTP_HMAC_PEPPER=dev_otp_hmac_pepper_must_be_at_least_32_chars_long_12345678
# 32 bytes hex. Generate with: openssl rand -hex 32
FIELD_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Background Worker ─────────────────────────────────────────────────────────
# When true, pg-boss runs inside the API server process
WORKER_INLINE=true

# ── Object Storage (Cloudflare R2) ────────────────────────────────────────────
# Storage adapter: 'console' (local mock), 'local' (filesystem), 'r2'
STORAGE_ADAPTER=console
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET=campusride-private

# ── Email Provider ────────────────────────────────────────────────────────────
# Email adapter: 'console' (logs to stdout), 'resend', 'brevo'
EMAIL_ADAPTER=console
EMAIL_FROM=noreply@campusride.example.com
RESEND_API_KEY=re_placeholder_api_key

# ── SMS / Phone OTP ───────────────────────────────────────────────────────────
# SMS adapter: 'console' (logs OTP to stdout), 'firebase', 'msg91'
SMS_ADAPTER=console
MSG91_AUTH_KEY=placeholder_msg91_auth_key

# ── Maps Provider ─────────────────────────────────────────────────────────────
# Maps adapter: 'fake' (deterministic mock routes/places), 'google'
MAPS_ADAPTER=fake
GOOGLE_MAPS_SERVER_KEY=placeholder_google_maps_server_key

# ── Push Notifications ────────────────────────────────────────────────────────
# Push adapter: 'console' (logs notifications), 'expo'
PUSH_ADAPTER=console
EXPO_ACCESS_TOKEN=placeholder_expo_access_token

# ── Metrics / Observability ───────────────────────────────────────────────────
# Bearer token required to access GET /api/v1/metrics
METRICS_TOKEN=dev_metrics_token_secret

# ── Analytics / Config Defaults ───────────────────────────────────────────────
EMISSION_KG_PER_KM_CAR=0.17
