{
  "openapi": "3.1.0",
  "info": {
    "title": "CampusRide API",
    "version": "1.0.0",
    "description": "Community ride-sharing API with passwordless authentication, rotating refresh tokens, trust tiers, and safety controls.",
    "contact": {
      "name": "CampusRide Support",
      "email": "support@campusride.example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001/api/v1",
      "description": "Local development server"
    },
    {
      "url": "https://api.campusride.example.com/api/v1",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived (15 min) HS256 access JWT"
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rt",
        "description": "Rotating refresh token httpOnly cookie"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ]
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "OtpVerify": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "tokenType"
        ]
      },
      "SessionItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "ipHash": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "createdAt",
          "expiresAt",
          "isCurrent"
        ]
      },
      "ConsentItemInput": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tos",
              "privacy",
              "location",
              "sos_contact_notice"
            ]
          },
          "version": {
            "type": "string"
          },
          "granted": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "version",
          "granted"
        ]
      },
      "ConsentSubmission": {
        "type": "object",
        "properties": {
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentItemInput"
            }
          },
          "adultConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "consents"
        ]
      },
      "MeProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "phoneE164": {
            "type": "string",
            "nullable": true
          },
          "phoneVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "photoKey": {
            "type": "string",
            "nullable": true
          },
          "memberType": {
            "type": "string",
            "enum": [
              "student",
              "staff",
              "community"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "admin",
              "safety_admin",
              "analyst"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "deleted"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male",
              "non_binary",
              "undisclosed"
            ]
          },
          "genderVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "collegeVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "department": {
            "type": "string",
            "nullable": true
          },
          "academicYear": {
            "type": "integer",
            "nullable": true
          },
          "adultConfirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "locale": {
            "type": "string"
          },
          "trustTier": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrustProfileResponse": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "integer"
                },
                "step": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Service is ready"
          },
          "503": {
            "description": "Service not ready"
          }
        }
      }
    },
    "/auth/otp/request": {
      "post": {
        "summary": "Request email OTP code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic success response (preventing user enumeration)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "summary": "Verify OTP code and authenticate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired OTP"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token and issue new access JWT",
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens"
                }
              }
            }
          },
          "401": {
            "description": "Invalid session or token reuse detected"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke current session",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "summary": "List active sessions for current user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SessionItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sessions/{id}": {
      "delete": {
        "summary": "Revoke a specific session",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Get current user profile and trust tier",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeProfileResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update user profile fields",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me/consents": {
      "post": {
        "summary": "Record or update versioned consents",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consents updated"
          }
        }
      }
    },
    "/me/trust": {
      "get": {
        "summary": "Get computed trust tier and step completion breakdown",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrustProfileResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}