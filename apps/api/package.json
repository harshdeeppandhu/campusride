{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "CampusRide API — Express 5 + Drizzle + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm --clean",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:int": "vitest run --reporter=verbose --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "openapi:gen": "tsx scripts/openapi-gen.ts"
  },
  "dependencies": {
    "@campusride/shared": "workspace:*",
    "express": "^5.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.1",
    "zod": "^3.23.8",
    "pg": "^8.13.1",
    "drizzle-orm": "^0.36.4",
    "dotenv": "^16.4.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.9.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0"
  }
}
